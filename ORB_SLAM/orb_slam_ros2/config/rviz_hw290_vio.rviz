Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: ORB-SLAM3 VIO path
      Topic: /orbslam_vio/path
      Enabled: true
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/PointCloud2
      Name: Tracked map points
      Topic: /orbslam_vio/tracked_map_points
      Enabled: true
      Size (Pixels): 3
    - Class: rviz_default_plugins/Image
      Name: Tracking image
      Topic: /orbslam_vio/tracking_image
      Enabled: true
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Topic: /cam0/image_raw
      Enabled: true
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Right camera
      Topic: /cam1/image_raw
      Enabled: true
      Normalize Range: true
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_common/Interact
    - Class: rviz_common/MoveCamera
    - Class: rviz_common/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point: 0; 0; 0
      Pitch: 1.0
      Yaw: 0.8
